new file mode 100644
index 0000000..5e0272d
--- /dev/null
+++ b/frontend/library/tests/interface_pins.rs
@@ -0,0 +1,30 @@
+//! Interface pins (field report): every `Config::interface` pin is drawn at
+//! its declared side and labels its net there, whether a drawable device
+//! touches the net (routed in) or not (a passive-only or floating port).
+
+use library::{Interface, IoPin, Side};
+
+#[test]
+fn a_passive_only_and_a_floating_port_are_drawn_and_labelled_at_their_sides() {
+    let pdk = verify::Pdk::builtin("sky130").expect("sky130 loads");
+    let spice = ".subckt a out g cap fl VDD VSS\nXM1 out g VSS VSS nfet_01v8 W=1u L=0.15u\nC1 out cap 100f\n.ends a\n";
+    let pin = |net: &str, side| IoPin { net: net.into(), side, frac: 0.5, width_nm: 800, layer: "met3".into() };
+    let interface = Interface { die_nm: None, pins: vec![pin("cap", Side::North), pin("fl", Side::East)] };
+    let cfg = library::Config { feedback_iters: 1, interface: Some(interface), ..Default::default() };
+    let sol = library::run(spice, &pdk, &library::Macros::default(), &cfg).expect("flow");
+    let signoff = library::signoff(&sol, &pdk);
+    // No LVS row, and dr stacks no second via3 beside a met3 pin's own (via3.1 is an exact size).
+    let bad: Vec<&str> = signoff.report.hard_violations.iter().map(|v| v.rule.as_str()).filter(|r| r.starts_with("lvs") || r.starts_with("engine/") || r.starts_with("drc/via3.1")).collect();
+    assert!(bad.is_empty(), "{bad:?}");
+
+    // Every other macro's outline, against which the sides are read.
+    let placed = pnr_core::place_macros(&sol.macros, &sol.layout);
+    let rest: Vec<pnr_core::Rect> = placed.iter().filter(|m| !m.pins.iter().any(|p| p.name.starts_with("io:"))).map(|m| m.bbox).collect();
+    let (_, pins, _) = library::signoff_inputs(&sol, &pdk);
+    let met3 = pnr_core::Process::layer(&pdk, "met3").expect("met3").0;
+    let label = |net: &str| pins.iter().find(|p| p.name == net).unwrap_or_else(|| panic!("{net} has no label: {pins:?}"));
+    let cap = label("cap");
+    assert!(cap.layer == met3 && rest.iter().all(|r| cap.y > r.y + r.h), "cap not on the north side: {cap:?}");
+    let fl = label("fl");
+    assert!(fl.layer == met3 && rest.iter().all(|r| fl.x > r.x + r.w), "fl not on the east side: {fl:?}");
+}
