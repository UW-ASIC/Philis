+/// One fixed one-rect cell per interface pin: `width` square on its layer,
+/// at its side of `around`'s outline (cleared by twice the layer's spacing),
+/// centred `frac` along that side. Its pin (`io:k`) is routed in as a terminal
+/// of its net and labels the net there ([`labeled_pins`]), so a port no
+/// drawable device touches (passive-only, floating) is still drawn and named.
+fn io_pins(io: &[(pnr_core::NetId, IoPin)], around: &[Macro], pdk: &Pdk, grid: i32) -> Vec<Macro> {
+    use pnr_core::{Pin, Process as _, Rect, Shape};
+    let g = grid.max(1);
+    let dn = |v: i32| v.div_euclid(g) * g;
+    let up = |v: i32| dn(v + g - 1);
+    let b = around.iter().map(|m| m.bbox).reduce(|a, b| {
+        let (x0, y0) = (a.x.min(b.x), a.y.min(b.y));
+        Rect { x: x0, y: y0, w: (a.x + a.w).max(b.x + b.w) - x0, h: (a.y + a.h).max(b.y + b.h) - y0 }
+    });
+    let b = b.unwrap_or(Rect { x: 0, y: 0, w: 0, h: 0 });
+    io.iter()
+        .enumerate()
+        .filter_map(|(k, (net, p))| {
+            let layer = pdk.layer(&p.layer)?;
+            let s = up(p.width_nm.max(pdk.width(&p.layer).unwrap_or(0)));
+            let gap = up(2 * pdk.space(&p.layer).unwrap_or(0));
+            let (x0, y0, x1, y1) = (b.x - gap, b.y - gap, b.x + b.w + gap, b.y + b.h + gap);
+            let along = |lo: i32, hi: i32| up(lo + ((hi - lo) as f32 * p.frac) as i32 - s / 2);
+            let (x, y) = match p.side {
+                Side::North => (along(x0, x1), up(y1)),
+                Side::South => (along(x0, x1), dn(y0 - s)),
+                Side::East => (up(x1), along(y0, y1)),
+                Side::West => (dn(x0 - s), along(y0, y1)),
+            };
+            let at = Rect { x, y, w: s, h: s };
+            Some(Macro { shapes: vec![Shape { layer, rect: at }], pins: vec![Pin { name: format!("io:{k}"), net: *net, at, layer }], bbox: at, ..Default::default() })
+        })
+        .collect()
+}
