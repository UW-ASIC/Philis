{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gdsverify.capabilities.schema/v1",
  "title": "gdsverify verification capability audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status_date",
    "baseline_commit",
    "score_policy",
    "states",
    "summary",
    "engines",
    "external_prerequisites"
  ],
  "properties": {
    "$schema": { "const": "capabilities.schema.json" },
    "schema_version": { "const": "gdsverify.capabilities/v1" },
    "status_date": { "type": "string", "format": "date" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "score_policy": { "const": "frozen_until_general_supported_input_has_independent_correlation" },
    "states": {
      "const": ["absent", "foundation", "partial", "integration_pending", "correlated", "qualified"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "total", "percent", "qualification"],
      "properties": {
        "implemented": { "const": 24.5 },
        "total": { "const": 112 },
        "percent": { "const": 22 },
        "qualification": { "const": "unqualified" }
      }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drc", "lvs", "pex"],
      "properties": {
        "drc": { "$ref": "#/$defs/drc_engine" },
        "lvs": { "$ref": "#/$defs/lvs_engine" },
        "pex": { "$ref": "#/$defs/pex_engine" }
      }
    },
    "external_prerequisites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "state": {
      "enum": ["absent", "foundation", "partial", "integration_pending", "correlated", "qualified"]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "score", "state"],
      "properties": {
        "families": { "const": 4 },
        "score": { "type": "number", "minimum": 0, "maximum": 4 },
        "state": { "$ref": "#/$defs/state" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "total", "percent", "claim", "groups"],
      "properties": {
        "implemented": { "type": "number", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "claim": { "type": "string", "minLength": 1 },
        "groups": { "type": "object" }
      }
    },
    "drc_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_hierarchy", "exact_geometry", "core_dimensions", "context_tables",
        "cuts_vias", "electrical_layout_context", "density_fill_cmp", "antenna",
        "patterning_yield", "advanced_process_package", "production_infrastructure"
      ],
      "properties": {
        "input_hierarchy": { "$ref": "#/$defs/group" },
        "exact_geometry": { "$ref": "#/$defs/group" },
        "core_dimensions": { "$ref": "#/$defs/group" },
        "context_tables": { "$ref": "#/$defs/group" },
        "cuts_vias": { "$ref": "#/$defs/group" },
        "electrical_layout_context": { "$ref": "#/$defs/group" },
        "density_fill_cmp": { "$ref": "#/$defs/group" },
        "antenna": { "$ref": "#/$defs/group" },
        "patterning_yield": { "$ref": "#/$defs/group" },
        "advanced_process_package": { "$ref": "#/$defs/group" },
        "production_infrastructure": { "$ref": "#/$defs/group" }
      }
    },
    "lvs_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_and_layout_input", "connectivity", "mos", "other_devices",
        "properties", "matching_witnesses", "reductions_equivalence", "hierarchy",
        "production_infrastructure"
      ],
      "properties": {
        "reference_and_layout_input": { "$ref": "#/$defs/group" },
        "connectivity": { "$ref": "#/$defs/group" },
        "mos": { "$ref": "#/$defs/group" },
        "other_devices": { "$ref": "#/$defs/group" },
        "properties": { "$ref": "#/$defs/group" },
        "matching_witnesses": { "$ref": "#/$defs/group" },
        "reductions_equivalence": { "$ref": "#/$defs/group" },
        "hierarchy": { "$ref": "#/$defs/group" },
        "production_infrastructure": { "$ref": "#/$defs/group" }
      }
    },
    "pex_groups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_stack_corners", "node_graph_terminals", "resistance",
        "ground_capacitance", "coupling", "device_substrate",
        "rlc_frequency_thermal", "outputs_reduction_correlation"
      ],
      "properties": {
        "process_stack_corners": { "$ref": "#/$defs/group" },
        "node_graph_terminals": { "$ref": "#/$defs/group" },
        "resistance": { "$ref": "#/$defs/group" },
        "ground_capacitance": { "$ref": "#/$defs/group" },
        "coupling": { "$ref": "#/$defs/group" },
        "device_substrate": { "$ref": "#/$defs/group" },
        "rlc_frequency_thermal": { "$ref": "#/$defs/group" },
        "outputs_reduction_correlation": { "$ref": "#/$defs/group" }
      }
    },
    "drc_engine": {
      "allOf": [
        { "$ref": "#/$defs/engine" },
        {
          "properties": {
            "implemented": { "const": 12.0 },
            "total": { "const": 44 },
            "percent": { "const": 27 },
            "groups": { "$ref": "#/$defs/drc_groups" }
          }
        }
      ]
    },
    "lvs_engine": {
      "allOf": [
        { "$ref": "#/$defs/engine" },
        {
          "properties": {
            "implemented": { "const": 8.0 },
            "total": { "const": 36 },
            "percent": { "const": 22 },
            "groups": { "$ref": "#/$defs/lvs_groups" }
          }
        }
      ]
    },
    "pex_engine": {
      "allOf": [
        { "$ref": "#/$defs/engine" },
        {
          "properties": {
            "implemented": { "const": 4.5 },
            "total": { "const": 32 },
            "percent": { "const": 14 },
            "groups": { "$ref": "#/$defs/pex_groups" }
          }
        }
      ]
    }
  }
}
