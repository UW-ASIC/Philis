{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdsverify.invalid/schemas/correlation/freeze-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inputs", "entries"],
  "properties": {
    "schema_version": { "const": "gdsverify.correlation.freeze/v1" },
    "inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
