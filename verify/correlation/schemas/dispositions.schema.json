{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdsverify.invalid/schemas/correlation/dispositions-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dispositions"],
  "properties": {
    "schema_version": { "const": "gdsverify.correlation.dispositions/v1" },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "owner", "reason", "scope", "created_at", "expires_at", "status"],
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "pattern": "^/[^*]+$", "not": { "const": "/" } },
          "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "expires_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "status": { "enum": ["approved", "rejected", "superseded"] }
        }
      }
    }
  }
}
