{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gdsverify.invalid/schemas/correlation/run-artifact-v1.json",
  "title": "gdsverify neutral correlation run artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "cases"],
  "properties": {
    "schema_version": { "const": "gdsverify.correlation.run/v1" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "versioned_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/nonempty" },
        "version": { "$ref": "#/$defs/nonempty" }
      }
    },
    "content_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "tool", "deck", "model", "corpus", "process", "corner", "command", "created_at"],
      "properties": {
        "engine": { "$ref": "#/$defs/versioned_identity" },
        "tool": { "$ref": "#/$defs/versioned_identity" },
        "deck": { "$ref": "#/$defs/content_identity" },
        "model": { "$ref": "#/$defs/content_identity" },
        "corpus": { "$ref": "#/$defs/content_identity" },
        "process": { "$ref": "#/$defs/nonempty" },
        "corner": { "$ref": "#/$defs/nonempty" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "value", "unit"],
      "properties": {
        "quantity": { "$ref": "#/$defs/nonempty" },
        "value": { "type": "number" },
        "unit": { "$ref": "#/$defs/nonempty" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_nm", "y_nm"],
      "properties": {
        "x_nm": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
        "y_nm": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x_nm", "min_y_nm", "max_x_nm", "max_y_nm"],
      "properties": {
        "min_x_nm": { "type": "integer" },
        "min_y_nm": { "type": "integer" },
        "max_x_nm": { "type": "integer" },
        "max_y_nm": { "type": "integer" }
      }
    },
    "ring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "points"],
      "properties": {
        "role": { "enum": ["outer", "hole"] },
        "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bbox", "rings"],
      "properties": {
        "bbox": { "$ref": "#/$defs/bbox" },
        "rings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ring" } }
      }
    },
    "drc_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "layer", "geometry", "measurements"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "rule_id": { "$ref": "#/$defs/nonempty" },
        "layer": { "$ref": "#/$defs/nonempty" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "measurements": { "type": "array", "items": { "$ref": "#/$defs/quantity" } }
      }
    },
    "lvs_net": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pins"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "pins": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } }
      }
    },
    "lvs_device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "model", "terminals", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "kind": { "$ref": "#/$defs/nonempty" },
        "model": { "$ref": "#/$defs/nonempty" },
        "terminals": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/nonempty" }
        },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/quantity" } }
      }
    },
    "lvs_mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "schematic_objects", "layout_objects", "witness"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "kind": { "$ref": "#/$defs/nonempty" },
        "schematic_objects": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "layout_objects": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } },
        "witness": { "$ref": "#/$defs/nonempty" }
      }
    },
    "lvs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nets", "devices", "mismatches"],
      "properties": {
        "nets": { "type": "array", "items": { "$ref": "#/$defs/lvs_net" } },
        "devices": { "type": "array", "items": { "$ref": "#/$defs/lvs_device" } },
        "mismatches": { "type": "array", "items": { "$ref": "#/$defs/lvs_mismatch" } }
      }
    },
    "pex_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "net"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "net": { "$ref": "#/$defs/nonempty" }
      }
    },
    "pex_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "value"],
      "properties": {
        "mechanism": { "$ref": "#/$defs/nonempty" },
        "value": { "$ref": "#/$defs/quantity" }
      }
    },
    "pex_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to", "value", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/nonempty" },
        "kind": { "$ref": "#/$defs/nonempty" },
        "from": { "$ref": "#/$defs/nonempty" },
        "to": { "$ref": "#/$defs/nonempty" },
        "value": { "$ref": "#/$defs/quantity" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/pex_component" } }
      }
    },
    "pex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "elements"],
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/pex_node" } },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/pex_element" } }
      }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "result_ids"],
      "properties": {
        "check_id": { "$ref": "#/$defs/nonempty" },
        "status": { "enum": ["clean", "violations", "not_run", "error"] },
        "result_ids": { "type": "array", "items": { "$ref": "#/$defs/nonempty" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "peak_memory"],
      "properties": {
        "runtime": { "$ref": "#/$defs/quantity" },
        "peak_memory": { "$ref": "#/$defs/quantity" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "drc_markers", "lvs", "pex", "signoff", "metrics"],
      "properties": {
        "case_id": { "$ref": "#/$defs/nonempty" },
        "drc_markers": { "type": "array", "items": { "$ref": "#/$defs/drc_marker" } },
        "lvs": { "$ref": "#/$defs/lvs" },
        "pex": { "$ref": "#/$defs/pex" },
        "signoff": { "type": "array", "items": { "$ref": "#/$defs/signoff" } },
        "metrics": { "$ref": "#/$defs/metrics" }
      }
    }
  }
}
